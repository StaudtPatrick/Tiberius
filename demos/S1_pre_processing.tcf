# Tiberius Control File for Stage 1: Pre-Processing

# Instrument used: Choose between "JWST", "EFOSC2", "ACAM" and "KECK"
instrument:                  "EFOSC2"


# Pipeline stages
stage1:
  skip_bias:	           	    False
  skip_flats:	              	True
  skip_1fcorrection:         	True	
  skip_cosmics:		          	False
  skip_badpixelmask:          True	

# Bias
bias:
  list:                 	"/path/to/file"
  verbose:              	True
  clobber:	           	  True
  savefigs:             	True

# Flats
flats:
  list:                   "/path/to/file"
# Under construction

# 1/f correction
# Under construction

# Cosmic rays
locate_cosmics:
  list          	         /path/to/file  or take automatically ?
  master_bias_file       	 #take automatically ??
  pixelclip                8
  verbose		               True
  saveframes		           True
  savecosmics	             True
  review                   True

